{
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    ".gitignore": ".gitattributes, .gitmodules, .gitmessage, .mailmap, .git-blame*, .gitignorerc.json",
    ".env": "*.env, .env*, env.d.ts",
    "*.ts": "$(capture).test.ts",
    "dockerfile": ".dockerignore, dockerfile*, .rancher-pipeline.yml, deployment.yaml, run.sh",
    "package.json": ".eslint*, .husky*, .jslint*, .prettier*, .stylelint*, .vscode*, .yarnrc*, jasmine.*, jenkins*, lint-staged*, .lintstaged*, package-lock.json, prettier*, tsconfig.*, yarn*, lerna.json, .editorConfig",
    "Dockerfile": "docker-compose.yaml, docker-compose-debug.yaml"
  },
  "terminal.integrated.scrollback": 100000,
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "**/*.modified": true,
    "**/*.deleted": true
  },
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/build/**": true,
    "**/.turbo/**": true,
    "**/.cache/**": true,
    "**/.next/**": true,
    "**/.nuxt/**": true,
    "**/.output/**": true,
    "**/.astro/**": true,
    "**/coverage/**": true,
    "**/.nyc_output/**": true,
    "**/*.log": true,
    "**/*.modified": true,
    "**/*.deleted": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/bower_components": true,
    "**/dist": true,
    "**/build": true,
    "**/.turbo": true,
    "**/.cache": true,
    "**/.next": true,
    "**/.nuxt": true,
    "**/.output": true,
    "**/.astro": true,
    "**/coverage": true,
    "**/*.modified": true,
    "**/*.deleted": true
  },
  "diffEditor.ignoreTrimWhitespace": true,
  "diffEditor.experimental.showMoves": true,
  "search.smartCase": true,
  "search.useIgnoreFiles": true,
  "editor.linkedEditing": true,
  "editor.bracketPairColorization.enabled": true,
  "html.autoClosingTags": true,
  "javascript.autoClosingTags": true,
  "typescript.autoClosingTags": true,
  "typescript.tsserver.maxTsServerMemory": 4096,
  "typescript.tsserver.experimental.enableProjectDiagnostics": false,
  "typescript.tsserver.useSeparateSyntaxServer": "forFilter",
  "javascript.suggest.completeFunctionCalls": true,
  "workbench.tree.indent": 16,
  "workbench.tree.renderIndentGuides": "always",
  "files.insertFinalNewline": true,
  "editor.largeFileOptimizations": true,
  "typescript.preferences.quoteStyle": "single",
  "javascript.preferences.quoteStyle": "single",
  "editor.maxTokenizationLineLength": 20000,
  "debug.javascript.autoAttachFilter": "smart",
  "git.detectSubmodules": false
}
