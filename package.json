{
  "name": "knuth",
  "version": "0.1.0",
  "description": "配置驱动、安全加固的 Verdaccio 私有 NPM 注册表部署套件",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "init": "node scripts/init.ts",
    "check": "node scripts/init.ts --check",
    "test": "node --test tests/*.test.ts",
    "clean": "rm -rf storage/data conf/htpasswd",
    "changelog": "changelog",
    "release": "semantic-release --no-ci"
  },
  "devDependencies": {
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/git": "10.0.1",
    "conventional-changelog-conventionalcommits": "8.0.0",
    "semantic-release": "24.0.0"
  },
  "keywords": [
    "verdaccio",
    "npm-registry",
    "private-registry",
    "docker-compose",
    "knuth"
  ],
  "author": "itonyyo",
  "license": "MIT"
}
